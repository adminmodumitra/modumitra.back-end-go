{
  "Driver": "postgres",
  "Drivers": ["postgres", "redis", "mongodb"],
  "SQL": {
    "Enabled": true,
    "Driver": "postgres",
    "DSN": "postgres://USER:PASSWORD@db.example.com:5432/cabinet_studio?sslmode=require",
    "MaxOpenConns": 25,
    "MaxIdleConns": 10,
    "ConnMaxLifetime": "1h"
  },
  "Redis": {
    "Enabled": true,
    "Addr": "redis.example.com:6379",
    "Password": "CHANGE_ME",
    "DB": 0,
    "TLS": true,
    "MaxOpenConns": 25,
    "MaxIdleConns": 10,
    "ConnMaxLifetime": "1h"
  },
  "NoSQL": {
    "Enabled": true,
    "URI": "mongodb+srv://USER:PASSWORD@cluster.example.com/?retryWrites=true&w=majority",
    "Database": "cabinet_studio",
    "MaxOpenConns": 25,
    "MaxIdleConns": 10,
    "ConnMaxLifetime": "1h"
  }
}
