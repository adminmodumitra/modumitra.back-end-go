      "studio_monthly": "price_studio_monthly_placeholder",
      "team_monthly": "price_team_monthly_placeholder"
    }
  },
  "oauth": {
    "google": {
      "client_id": "",
      "client_secret": ""
    },
    "facebook": {
      "client_id": "",
      "client_secret": ""
    },
    "x": {
      "client_id": "",
      "client_secret": ""
    },
