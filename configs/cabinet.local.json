{
  "http": {
    "addr": ":8080"
  },
  "log": {
    "level": "info",
    "format": "json",
    "sinks": ["stderr"]
  },
  "datastore": {
    "Driver": "postgres",
    "Drivers": ["postgres"],
    "SQL": {
      "Enabled": true,
      "Driver": "postgres",
      "DSN": "postgres://cabinet:cabinet@localhost:5432/cabinet_studio?sslmode=disable",
      "MaxOpenConns": 25,
      "MaxIdleConns": 10,
      "ConnMaxLifetime": "1h"
    },
    "Redis": {
      "Enabled": false,
      "Addr": "localhost:6379",
      "Password": "",
      "DB": 0,
      "TLS": false,
      "MaxOpenConns": 25,
      "MaxIdleConns": 10,
      "ConnMaxLifetime": "1h"
    },
    "NoSQL": {
      "Enabled": false,
      "URI": "mongodb://localhost:27017",
      "Database": "cabinet_studio",
      "MaxOpenConns": 25,
      "MaxIdleConns": 10,
      "ConnMaxLifetime": "1h"
    }
  },
  "jwt": {
    "secret": "cabinet-studio-local-dev-only-change-me",
    "access_ttl": "15m",
    "refresh_ttl": "720h"
  },
  "billing": {
    "provider": "auto",
    "webhook_secret": "cabinet-studio-billing-webhook-local-dev-only",
