# Cabinet Studio API
HTTP_ADDR=:8080

# Which cabinet JSON to load when CABINET_CONFIG is unset.
# local (default) → configs/cabinet.local.json
# dev / development → configs/cabinet.dev.json
# production / prod → configs/cabinet.production.json
# Unknown values fall back to local. CABINET_ENV is accepted as an alias.
APP_ENV=local
# Optional explicit path; wins over APP_ENV when set.
# CABINET_CONFIG=configs/cabinet.local.json
DATASTORE_DRIVER=postgres
# Concurrent: comma-separated. Example: postgres,redis,mongodb
# DATASTORE_DRIVERS=postgres,redis
DATABASE_URL=postgresql://neondb_owner:npg_RjYmC1OFShb6@ep-lingering-union-ax1hyikc-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# MONGO_URI=mongodb://localhost:27017
# MONGO_DATABASE=cabinet_studio

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=cabinet-studio-api
TERMS_VERSION=2026-06-01
PRIVACY_VERSION=2026-06-01
MIN_APP_VERSION=1.0.0
TRIAL_DAYS=14
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SINK=stderr
# Reserved sinks (fail boot until writers ship). Prefer scraping stderr:
# LOG_SINK=stderr,loki
# LOKI_URL=http://loki:3100
# LOG_SINK=stderr,cloudwatch
# CLOUDWATCH_LOG_GROUP=/cabinet/studio-api
# CLOUDWATCH_LOG_STREAM=
# AWS_REGION=ap-south-1

# HS256 secret for access JWTs. Default is local-only; never use in production.
JWT_SECRET=cabinet-studio-local-dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BBR_ENABLED=true
BBR_WINDOW_SIZE=10s
BBR_BUCKETS=100
BBR_CPU_THRESHOLD=800

# HMAC-SHA256 key for signed entitlement snapshots. Default is local-only; never use in production.
ENTITLEMENT_SIGNING_KEY=cabinet-studio-entitlement-local-dev-only-change-me

# Billing. provider auto (default) selects fake unless webhook secret is set AND
# both price ids are non-empty and contain no "placeholder". Then StripeProvider
# (still a stub — no live Stripe HTTP). Explicit fake / stripe override auto.
# Replacing price_*_placeholder (JSON or env) is enough; no Go change.
BILLING_PROVIDER=auto
BILLING_WEBHOOK_SECRET=cabinet-studio-billing-webhook-local-dev-only
BILLING_PRICE_STUDIO_MONTHLY=price_studio_monthly_placeholder
BILLING_PRICE_TEAM_MONTHLY=price_team_monthly_placeholder

# Kafka transactional outbox. Live when enabled AND brokers are non-empty.
# Local/dev uses NoopPublisher.
KAFKA_ENABLED=false
KAFKA_BROKERS=
KAFKA_CLIENT_ID=cabinet-studio-api

# OAuth / SSO. Disabled when client id or secret is empty or contains "placeholder".
# Replacing OAUTH_* in JSON or env is enough; no Go change.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_REDIRECT_URI=cabinetstudio://oauth/callback
OAUTH_DEVICE_VERIFICATION_URI=https://app.cabinetstudio.example/device

# Mail. log is LogMailer. smtp is reserved (fails boot until a writer ships).
MAIL_DRIVER=log
